# EventOps AI Configuration

# OpenRouter API Key (required for LLM and embedding calls)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Direct OpenAI API key for embeddings
# If set, embeddings use api.openai.com instead of OpenRouter
# OPENAI_API_KEY=your_openai_api_key_here

# LLM model routing — three tiers (all default to LLM_MODEL if unset)
# Balanced: structured extraction, streaming, auto-repair
LLM_MODEL=google/gemini-2.0-flash-001
# Fast: intent classification (~500ms, lowest cost)
# LLM_MODEL_FAST=google/gemini-2.5-flash-lite
# Strong: RAG synthesis, planning (highest accuracy)
# LLM_MODEL_STRONG=google/gemini-2.5-flash

# Database URL (async driver required)
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./eventops.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/eventops

# File upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# ChromaDB persistence directory (vector store)
CHROMA_PERSIST_DIR=chroma_db

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true
